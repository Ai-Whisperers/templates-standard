#!/usr/bin/env sh

# Husky commit-msg hook
# Validates commit message format

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Conventional Commits validation
# Format: <type>(<scope>): <subject>
# Types: feat, fix, docs, style, refactor, test, chore

if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\(.+\))?: .+"; then
    echo "ERROR: Commit message does not follow Conventional Commits format"
    echo ""
    echo "Format: <type>(<scope>): <subject>"
    echo ""
    echo "Types:"
    echo "  feat:     New feature"
    echo "  fix:      Bug fix"
    echo "  docs:     Documentation changes"
    echo "  style:    Code style changes (formatting, semicolons, etc.)"
    echo "  refactor: Code refactoring"
    echo "  test:     Adding or updating tests"
    echo "  chore:    Maintenance tasks"
    echo "  ci:       CI/CD changes"
    echo "  perf:     Performance improvements"
    echo "  build:    Build system changes"
    echo ""
    echo "Example: feat(api): add user authentication endpoint"
    echo ""
    exit 1
fi

# Check for minimum subject length
subject=$(echo "$commit_msg" | head -n 1 | sed 's/^[^:]*: //')
if [ ${#subject} -lt 10 ]; then
    echo "ERROR: Commit message subject is too short (minimum 10 characters)"
    exit 1
fi

# Check for maximum subject length
if [ ${#subject} -gt 72 ]; then
    echo "WARNING: Commit message subject is long (recommended max 72 characters)"
fi

echo "Commit message validated successfully!"

